<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B111E"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit V2ray Config"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Protocol" android:textColor="#A0A0A0" android:textSize="12sp" android:layout_marginBottom="4dp"/>
        <Spinner android:id="@+id/spV2Protocol" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input" android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Name" android:textColor="#A0A0A0" android:textSize="12sp" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/etV2Name" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input" android:textColor="#FFFFFF" android:padding="12dp" android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Server (Host/IP)" android:textColor="#A0A0A0" android:textSize="12sp" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/etV2Server" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input" android:textColor="#FFFFFF" android:padding="12dp" android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Port" android:textColor="#A0A0A0" android:textSize="12sp" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/etV2Port" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input" android:textColor="#FFFFFF" android:inputType="number" android:padding="12dp" android:layout_marginBottom="12dp"/>

        <!-- Password / UUID -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Password / UUID" android:textColor="#A0A0A0" android:textSize="12sp" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/etV2Id" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input" android:textColor="#FFFFFF" android:padding="12dp" android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Flow (Khusus VLESS)" android:textColor="#A0A0A0" android:textSize="12sp" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/etV2Flow" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input" android:textColor="#FFFFFF" android:padding="12dp" android:hint="xtls-rprx-vision" android:textColorHint="#808080" android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Transport" android:textColor="#A0A0A0" android:textSize="12sp" android:layout_marginBottom="4dp"/>
        <Spinner android:id="@+id/spV2Transport" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input" android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Path" android:textColor="#A0A0A0" android:textSize="12sp" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/etV2Path" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input" android:textColor="#FFFFFF" android:padding="12dp" android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Host Header" android:textColor="#A0A0A0" android:textSize="12sp" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/etV2Host" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input" android:textColor="#FFFFFF" android:padding="12dp" android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Security" android:textColor="#A0A0A0" android:textSize="12sp" android:layout_marginBottom="4dp"/>
        <Spinner android:id="@+id/spV2Security" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input" android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SNI" android:textColor="#A0A0A0" android:textSize="12sp" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/etV2Sni" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input" android:textColor="#FFFFFF" android:padding="12dp" android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ALPN" android:textColor="#A0A0A0" android:textSize="12sp" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/etV2Alpn" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input" android:textColor="#FFFFFF" android:padding="12dp" android:hint="h2,http/1.1" android:textColorHint="#808080" android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="uTLS Fingerprint" android:textColor="#A0A0A0" android:textSize="12sp" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/etV2Fingerprint" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input" android:textColor="#FFFFFF" android:padding="12dp" android:hint="chrome, firefox" android:textColorHint="#808080" android:layout_marginBottom="16dp"/>

        <!-- Switch Allow Insecure -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="24dp">
            <Switch android:id="@+id/swInsecure" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="16dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Allow insecure certificates" android:textColor="#FFFFFF" android:textSize="14sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Turns off certificate validation for this config." android:textColor="#A0A0A0" android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnUpdateV2ray"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="SAVE CONFIG"
            android:textColor="#000000"
            android:backgroundTint="#00FFCC"
            android:textStyle="bold"
            android:layout_marginBottom="30dp"/>

    </LinearLayout>
</ScrollView>